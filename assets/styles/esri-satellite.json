{
  "version": 8,
  "name": "ESRI-World-Imagery-Satellite",
  "metadata": {
    "maputnik:renderer": "mlgljs",
    "usage": "純衛星影像（無道路／地名標註）。MapScreen 預設的衛星模式改採用 esri-hybrid.json（Google 混合地圖風格），此檔保留作為無標註影像的備用底圖"
  },
  "sources": {
    "esriImagery": {
      "type": "raster",
      "tiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "minzoom": 0,
      "maxzoom": 19,
      "attribution": "© <a href=\"https://www.esri.com/\">Esri</a>, Maxar, Earthstar Geographics, and the GIS User Community"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#000000"
      }
    },
    {
      "id": "esri-satellite",
      "type": "raster",
      "source": "esriImagery",
      "minzoom": 0,
      "maxzoom": 22,
      "paint": {
        "raster-opacity": 1
      }
    }
  ]
}
